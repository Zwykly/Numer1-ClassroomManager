# ---------------------------------------------------------------------------
# Classroom Manager - Docker Compose environment
# Copy this file to `.env` and adjust every value before deploying.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ------------------------------------------------
POSTGRES_USER=classroom
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=classroom_manager

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public URL where the backend is reachable (used by better-auth).
# Local testing: http://localhost:3000
# Production (nginx + api subdomain): https://api.example.com
BETTER_AUTH_URL=http://localhost:3000
# Comma separated list of frontend origins allowed to call the backend (CORS).
# Local testing: http://localhost:3030
# Production: https://app.example.com
TRUSTED_ORIGINS=http://localhost:3030

# --- Initial admin account (seeded on first start, idempotent) -------------
ADMIN_EMAIL=admin@classroom.local
ADMIN_PASSWORD=Admin1234!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# --- Frontend --------------------------------------------------------------
# Public URL of the backend as seen by the browser.
# Leave empty when the backend is reachable on the same host at :3000.
# Production (nginx + api subdomain): https://api.example.com
BUN_PUBLIC_API_URL=

# --- Networking ------------------------------------------------------------
# Bind address for published ports. Keep 127.0.0.1 when nginx terminates TLS
# on the host. Use 0.0.0.0 only for direct testing without a reverse proxy.
BIND_ADDR=127.0.0.1
FRONTEND_PORT=3030
BACKEND_PORT=3000

# --- Container images (GHCR, built by GitHub Actions on main) --------------
BACKEND_IMAGE=ghcr.io/zwykly/numer1-classroommanager-backend:latest
FRONTEND_IMAGE=ghcr.io/zwykly/numer1-classroommanager-frontend:latest

# --- Offsite backups (rclone) ----------------------------------------------
# rclone remote + bucket/path, e.g. "b2:classroom-backups" or "s3:my-bucket/cm".
RCLONE_REMOTE=change-me:classroom-backups
# How often a dump is taken and shipped (seconds). Default: 24h.
BACKUP_INTERVAL_SECONDS=86400
# Local dumps older than this are pruned from the db_backups volume.
BACKUP_RETENTION_DAYS=14
