# ---------------------------------------------------------------------------
# Classroom Manager - Docker Compose environment
# Copy this file to `.env` and adjust the values before starting the stack:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=classroom
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=classroom_manager

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public URL where the backend is reachable (used by better-auth).
BETTER_AUTH_URL=http://localhost:3000
# Comma separated list of frontend origins allowed to call the backend (CORS).
TRUSTED_ORIGINS=http://localhost:3030

# --- Initial admin account (seeded on first start, idempotent) -------------
ADMIN_EMAIL=admin@classroom.local
ADMIN_PASSWORD=Admin1234!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# --- Frontend --------------------------------------------------------------
# Public URL of the backend as seen by the browser.
BUN_PUBLIC_API_URL=http://localhost:3000

# --- Published ports -------------------------------------------------------
FRONTEND_PORT=3030
BACKEND_PORT=3000
DB_PORT=5432

# --- Container images (built by GitHub Actions and published to Docker Hub) -
BACKEND_IMAGE=zwykly/numer1-classroommanager-backend:latest
FRONTEND_IMAGE=zwykly/numer1-classroommanager-frontend:latest
