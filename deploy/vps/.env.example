# ---------------------------------------------------------------------------
# Classroom Manager - VPS environment
# Copy to `.env` and adjust every value before starting the stack.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ------------------------------------------------
POSTGRES_USER=classroom
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=classroom_manager

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public URL where the backend is reachable (used by better-auth).
BETTER_AUTH_URL=https://api.example.com
# Comma separated frontend origins allowed to call the backend (CORS).
TRUSTED_ORIGINS=https://app.example.com

# --- Initial admin account (seeded on first start, idempotent) -------------
ADMIN_EMAIL=admin@classroom.local
ADMIN_PASSWORD=Admin1234!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# --- Frontend --------------------------------------------------------------
# Public URL of the backend as seen by the browser, e.g. https://api.example.com
BUN_PUBLIC_API_URL=https://api.example.com

# --- Networking ------------------------------------------------------------
# Keep 127.0.0.1 when nginx on the host terminates TLS.
BIND_ADDR=127.0.0.1
FRONTEND_PORT=3030
BACKEND_PORT=3000

# --- Container images (published to GHCR by GitHub Actions) ----------------
BACKEND_IMAGE=ghcr.io/zwykly/numer1-classroommanager-backend:latest
FRONTEND_IMAGE=ghcr.io/zwykly/numer1-classroommanager-frontend:latest
BACKUP_IMAGE=ghcr.io/zwykly/numer1-classroommanager-backup:latest

# --- Offsite backups (rclone) ----------------------------------------------
# rclone remote + path, e.g. "b2:classroom-backups" or "s3:my-bucket/cm".
RCLONE_REMOTE=change-me:classroom-backups
# How often a dump is taken and shipped (seconds). Default: 24h.
BACKUP_INTERVAL_SECONDS=86400
# Local dumps older than this are pruned from the db_backups volume.
BACKUP_RETENTION_DAYS=14
